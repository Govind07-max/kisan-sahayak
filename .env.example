# ---------------------------------------------------------------------------
# Kisan Sahayak configuration
# Copy this file to .env and fill in the required values.
# NEVER commit .env or an API key.
# ---------------------------------------------------------------------------

# LLM provider: gemini (default) or ollama.
# There is no automatic fallback between providers.
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini.
# Get a key from Google AI Studio. Do not put the key in source code.
GEMINI_API_KEY=

# Required when LLM_PROVIDER=gemini.
# This project intentionally does not hardcode a model ID because available
# models change. List the models available to YOUR key first:
#   .venv/bin/python ingest.py --list-models
# Then set one model ID that appears in that list, for example:
#   GEMINI_MODEL=<model-name-from-the-list>
GEMINI_MODEL=

GEMINI_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1400

# Optional local Ollama provider instead of Gemini.
# Start Ollama separately with: ollama serve
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_SECONDS=120

# Embeddings (local, CPU by default). The model is downloaded on first use.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Vector store
CHROMA_PATH=storage/chroma_db
COLLECTION_NAME=farmer_knowledge

# Document paths (relative paths are resolved from the project root)
DOCUMENT_DIR=data/raw
INVENTORY_PATH=data/metadata/document_inventory.csv
MANIFEST_PATH=storage/ingestion_manifest.json
PROCESSED_DIR=data/processed
FAILED_DIR=data/failed

# Chunking (in words). The local embedding model has a 128-token limit, so
# overlapping 200-word windows are used; the 100-word overlap makes the whole
# document searchable even though a single embedding sees only the start.
CHUNK_SIZE=200
CHUNK_OVERLAP=100

# Retrieval
TOP_K=5
# Keep the final result list diverse across documents.
MAX_CHUNKS_PER_DOCUMENT=2
# Expand common Marathi/Hindi scheme names into English retrieval terms.
QUERY_EXPANSION_ENABLED=true
# Calibrated on the current 2,240-chunk index: 0.66 keeps all supported
# evaluation questions and rejects all six unsupported ones. Leave blank to
# inspect raw retrieval scores; lower the value if valid questions are refused.
RELEVANCE_THRESHOLD=0.66
MAX_CONTEXT_CHARS=14000

# OCR. The application auto-detects the bundled Tesseract under .local/tesseract.
# Set TESSERACT_CMD only if you want to use a different installation.
OCR_ENABLED=true
OCR_LANGUAGES=mar+hin+eng
OCR_DPI=180
OCR_MIN_CHARS=50
OCR_PAGE_TIMEOUT_SECONDS=120
TESSERACT_CMD=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/kisan_sahayak.log
